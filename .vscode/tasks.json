// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "build",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": ["$tsc"],
			"label": "npm: build",
			"detail": "Build the extension and React frontend"
		},
		{
			"type": "npm",
			"script": "dev",
			"isBackground": true,
			"group": "build",
			"problemMatcher": [
				"$tsc-watch",
				{
					"pattern": [
						{
							"regexp": ".",
							"file": 1,
							"location": 2,
							"message": 3
						}
					],
					"background": {
						"activeOnStart": true,
						"beginsPattern": "vite",
						"endsPattern": "ready in"
					}
				}
			],
			"label": "npm: dev",
			"detail": "Watch and rebuild the extension and React frontend"
		}
	]
}
